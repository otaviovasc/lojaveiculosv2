# Runtime
NODE_ENV=development
APP_ENV=local
PORT=8787
# Railway injects these built-ins. Leave them empty locally.
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=
RAILWAY_ENVIRONMENT_NAME=
RAILWAY_GIT_COMMIT_SHA=
# Optional equivalent used by non-Railway build pipelines.
BUILD_COMMIT_SHA=
# Older Railway/runtime compatibility signal; may be a name or opaque id.
RAILWAY_ENVIRONMENT=
PUBLIC_APP_URL=http://localhost:5173
API_BASE_URL=http://localhost:8787
VITE_API_BASE_URL=/api/v1
VITE_DEV_API_PROXY_TARGET=http://localhost:8787
VITE_DEV_PUBLIC_STORE_HOST=test-store.lojaveiculos.com.br
DB_POOL_MAX=5
AUDIT_DB_POOL_MAX=5
DB_CLOSE_TIMEOUT_SECONDS=5
SHUTDOWN_TIMEOUT_MS=10000
READINESS_TIMEOUT_MS=2000
WEB_DIST_DIR=
DEV_SUPERVISOR_SHUTDOWN_TIMEOUT_MS=8000
# Base URL for local Playwright and UI-audit tooling.
PLAYWRIGHT_BASE_URL=http://127.0.0.1:5173

# Product databases
# Local Docker defaults. These are development-only credentials from docker-compose.yml.
DATABASE_URL=postgresql://lojaveiculosv2:lojaveiculosv2_dev@localhost:54321/lojaveiculosv2
AUDIT_DATABASE_URL=postgresql://lojaveiculosv2_audit:lojaveiculosv2_audit_dev@localhost:54322/lojaveiculosv2_audit
# Staging database URL aliases (used by staging CLI scripts and grant tools)
STAGING_DB=
STAGING_AUDIT_DB=
SEED_SOURCE_DATABASE_URL=
# Internal local schema-sync phase flag. The DB push wrapper sets this
# automatically; do not configure it on Railway.
DRIZZLE_AUTOMATION_BOOTSTRAP=false
# Internal local schema-sync phase flag for financing scope foreign keys.
# The DB push wrapper sets this automatically; do not configure it on Railway.
DRIZZLE_SCOPE_FOREIGN_KEY_BOOTSTRAP=false

# Railway production values should be service reference variables, not copied
# local URLs:
# DATABASE_URL=${{lojaveiculosv2-postgres.DATABASE_URL}}
# AUDIT_DATABASE_URL=${{lojaveiculosv2-audit-postgres.DATABASE_URL}}

# Optional infra services
# REDIS_URL=${{redis.REDIS_URL}}
REDIS_URL=redis://localhost:63790

# CRM ZAPI test connection
# Leave secrets empty in committed files. Set RUN_ZAPI_E2E=true only when you
# intentionally want local tests to send/receive real WhatsApp traffic.
CRM_CONNECTION_CREDENTIAL_ENCRYPTION_KEY=
CRM_OLX_WEBHOOK_ALLOWED_IPS=
CRM_OLX_TRUST_PROXY_HEADERS=false
CRM_ZAPI_API_BASE_URL=https://api.z-api.io
CRM_ZAPI_REQUEST_TIMEOUT_MS=10000
CRM_ZAPI_TEST_INSTANCE_ID=
CRM_ZAPI_TEST_INSTANCE_TOKEN=
CRM_ZAPI_TEST_CLIENT_TOKEN=
# ZAPI account security token (Client-Token header). Also authorizes the
# "Configurar webhooks na ZAPI" action that auto-registers callback URLs.
CRM_ZAPI_CLIENT_TOKEN=
ZAPI_CLIENT_TOKEN=
CRM_ZAPI_TEST_PAIR_PHONE=
# Required outside APP_ENV=local; append ?token=... to ZAPI callback URLs
# when custom headers are not available. This is the secret the connection
# admin appends to every webhook URL it registers on ZAPI.
RUN_ZAPI_E2E=false

# CRM OLX Chat. Access tokens are encrypted per CRM connection with the shared
# CRM connection credential key above.
# Keep disabled until the official V2 redirect URI, chat contract, and
# provider acceptance evidence exist. Only the exact value `true` enables it.
CRM_OLX_CHAT_ENABLED=false

# Official WhatsApp Cloud API and Instagram professional messaging via
# Composio's REST proxy. CRM connection rows store only the API-key env name,
# Composio connected-account id, native Meta sender id, and Graph version.
COMPOSIO_API_KEY=
COMPOSIO_API_BASE_URL=https://backend.composio.dev
COMPOSIO_META_GRAPH_VERSION=
COMPOSIO_REQUEST_TIMEOUT_MS=10000
COMPOSIO_WHATSAPP_TOOLKIT_VERSION=20260721_00
# Server-owned auth-config identifiers used by customer self-service and
# crm:composio:* diagnostics. These are ac_ IDs, not ca_ connected-account IDs.
COMPOSIO_WHATSAPP_AUTH_CONFIG_ID=
COMPOSIO_INSTAGRAM_AUTH_CONFIG_ID=
# Required for Instagram self-service: facebook or instagram.
COMPOSIO_INSTAGRAM_LOGIN_MODE=
CRM_META_WEBHOOK_VERIFY_TOKEN=
CRM_META_APP_SECRET=

# External Bot Manager. Keep effects disabled until an approved model version,
# per-integration bearer credential, and separate outbound signing key exist.
# Example variable name used by the copyable external-bot client snippets. This
# belongs in the bot deployment, not in the Loja API or web service.
CRM_WEBHOOK_SECRET=
CRM_EXTERNAL_BOT_MODEL_VERSION=
CRM_EXTERNAL_BOT_EFFECT_BATCH_SIZE=25

# CRM retention worker. Dry-run is the safe default. Tenant/store are optional
# manual filters; scheduled runs discover and lease all eligible store scopes.
CRM_RETENTION_DRY_RUN=true
CRM_RETENTION_BATCH_SIZE=100
CRM_RETENTION_MAX_BATCHES=20
CRM_RETENTION_SCOPE_LIMIT=100
CRM_RETENTION_LEASE_SECONDS=900
CRM_RETENTION_TENANT_ID=
CRM_RETENTION_STORE_ID=

CRM_CONNECTION_CLEANUP_BATCH_SIZE=100
CRM_WHATSAPP_SCHEDULE_BATCH_SIZE=25
CRM_WHATSAPP_SCHEDULE_SCOPE_LIMIT=100
CRM_WHATSAPP_SCHEDULE_DUE_AT=

# Clerk
# Use a dedicated V2 Clerk project; do not reuse V1/Repasses secrets.
CLERK_SECRET_KEY=
# Optional: paste Clerk's JWT public key only if you want networkless
# verification with @clerk/backend.
CLERK_JWT_KEY=
# Optional: only set after a Clerk JWT template/session token emits the same
# aud claim and the frontend requests that token intentionally.
CLERK_AUDIENCE=
# Comma-separated allowed frontend origins, for example:
# https://app.example.com,https://staging.example.com
CLERK_AUTHORIZED_PARTIES=
VITE_CLERK_PUBLISHABLE_KEY=
# Reserved until a Clerk webhook route is mounted.
CLERK_WEBHOOK_SECRET=
CLERK_SIGN_IN_URL=http://localhost:5173/sign-in
CLERK_SIGN_UP_URL=http://localhost:5173/sign-up
CLERK_AFTER_SIGN_IN_URL=http://localhost:5173/auth/session
CLERK_AFTER_SIGN_UP_URL=http://localhost:5173/auth/session
CLERK_INVITATION_REDIRECT_URL=http://localhost:5173/auth/session

# Storage
# Cloudflare R2 application object storage.
# Used by inventory media, generated vehicle documents, finance attachments,
# CRM WhatsApp inbound media mirroring, and future domain files.
# Browser uploads also require the bucket CORS policy in docs/ops/r2-cors.md.
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=
R2_REGION=auto
# Local-only write allowlist. Set to the exact R2_BUCKET_NAME only when that
# bucket is dedicated to disposable development/test seed artifacts.
R2_SEED_WRITE_BUCKET=
R2_UPLOAD_URL_EXPIRES_SECONDS=900
R2_DOWNLOAD_URL_EXPIRES_SECONDS=300

# Marketplace provider integrations.
# Use a strong random value in production; used for encrypted provider tokens.
MARKETPLACE_CREDENTIAL_ENCRYPTION_KEY=
MERCADO_LIVRE_CLIENT_ID=
MERCADO_LIVRE_CLIENT_SECRET=
MERCADO_LIVRE_AUTHORIZATION_URL=https://auth.mercadolivre.com.br/authorization
MERCADO_LIVRE_API_BASE_URL=https://api.mercadolibre.com
MERCADO_LIVRE_TOKEN_URL=https://api.mercadolibre.com/oauth/token
MERCADO_LIVRE_ACCOUNT_PATH=/users/me
OLX_CLIENT_ID=
OLX_CLIENT_SECRET=

# Authless seeded preview only. Leave empty when testing real Clerk.
LOCAL_AUTH_BYPASS=
DEV_CLERK_USER_ID=
DEV_STORE_SLUG=
VITE_LOCAL_AUTH_BYPASS=
VITE_DEV_CLERK_USER_ID=
VITE_DEV_STORE_SLUG=
VITE_DEV_CLERK_SESSION_TOKEN=

# Billing
ASAAS_RUNTIME_IMPLEMENTATION=
ASAAS_API_KEY=
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_CHECKOUT_URL=https://sandbox.asaas.com/checkoutSession/show
ASAAS_BILLING_SYNC_TYPE=PIX
ASAAS_BILLING_SYNC_NEXT_DUE_DATE=
BILLING_SYNC_STORE_ID=
BILLING_SYNC_TENANT_ID=
ASAAS_WEBHOOK_SECRET=
ASAAS_WEBHOOK_URL=

# Credere financing
CREDERE_ENVIRONMENT=
# Required only for sandbox; production uses the allowlisted official API root.
CREDERE_API_ROOT=
CREDERE_CLIENT_ID=
CREDERE_CLIENT_SECRET=
CREDERE_REDIRECT_URI=
CREDERE_CREDENTIAL_ENCRYPTION_KEY=
# Optional allowlist. Leave unset to use all Credere active/okay banks for the mapped store.
CREDERE_BANK_POLICY_CODES=

# Integrations
FIPE_API_BASE_URL=https://parallelum.com.br/fipe/api/v2
FIPE_API_TOKEN=
FIPE_CATALOG_SYNC_BRAND_CODES=
FIPE_CATALOG_SYNC_BRAND_LIMIT=
FIPE_CATALOG_SYNC_CONCURRENCY=1
FIPE_CATALOG_SYNC_HTTP_MAX_ATTEMPTS=5
FIPE_CATALOG_SYNC_HTTP_TIMEOUT_MS=30000
FIPE_CATALOG_SYNC_INCLUDE_YEARS=true
FIPE_CATALOG_SYNC_HTTP_RETRY_BASE_MS=1000
FIPE_CATALOG_SYNC_REFERENCE_CODE=
FIPE_CATALOG_SYNC_REFRESH_AFTER_DAYS=30
FIPE_CATALOG_SYNC_REFRESH_EXISTING=false
FIPE_CATALOG_SYNC_VEHICLE_TYPES=cars,motorcycles,trucks
FIPE_CATALOG_NORMALIZE_DRY_RUN=true
FIPE_CSV_PATH=
CLICKSIGN_ACCESS_TOKEN=
CLICKSIGN_WEBHOOK_SECRET=
API_PLACA_KEY=
API_PLACA_BASE_URL=https://gateway.apibrasil.io/api/v2
API_PLACA_DADOS_PATH=/vehicles/base/000/dados
API_PLACA_CACHE_TTL_DAYS=30
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=openai/gpt-5.4-mini
OPENROUTER_DOCUMENTS_MODEL=openai/gpt-5.4-mini
OPENROUTER_INVENTORY_RESALE_MODEL=openai/gpt-5.4-mini
HEDRA_API_KEY=
HEDRA_API_BASE_URL=https://api.hedra.com
HEDRA_ASSET_PATH=/web-app/public/assets
HEDRA_ASSET_UPLOAD_PATH=/web-app/public/assets/{id}/upload
HEDRA_IMAGE_TO_IMAGE_PATH=/web-app/public/generations
HEDRA_GENERATION_STATUS_PATH=/web-app/public/generations/{id}/status
HEDRA_AUTH_HEADER=X-API-Key
HEDRA_AUTH_SCHEME=
HEDRA_FLUX_2_PRO_MODEL_ID=64795e67-412b-4d57-a24c-526cf909227d
HEDRA_POLL_INTERVAL_MS=1500
HEDRA_POLL_MAX_ATTEMPTS=120
HEDRA_REQUEST_TIMEOUT_MS=60000
HTTP_REQUEST_TIMEOUT_MS=240000
WEBMOTORS_CLIENT_ID=
WEBMOTORS_CLIENT_SECRET=
ICARROS_CLIENT_ID=
ICARROS_CLIENT_SECRET=

# Fiscal / NF-e + NFS-e provider
# The owner key only provisions/synchronizes store subaccounts. Store keys are
# encrypted in the database. Keep the encryption key stable per environment.
SPEDY_RUNTIME_IMPLEMENTATION=
SPEDY_API_URL=https://api.spedy.com.br/v1/
SPEDY_OWNER_API_KEY=
FISCAL_CREDENTIAL_ENCRYPTION_KEY=

# Production/public routing
APP_PRIMARY_DOMAIN=
API_PRIMARY_DOMAIN=
PUBLIC_STOREFRONT_ROOT_DOMAIN=lojaveiculos.com.br
PUBLIC_STOREFRONT_CUSTOM_DOMAIN_CNAME_TARGET=

# Provider webhooks
SPEDY_WEBHOOK_URL=https://api.example.com/api/v1/fiscal/webhooks/spedy/<opaque-token>
MERCADO_LIVRE_WEBHOOK_URL=

# Observability
LOG_LEVEL=info
# Set false only when an approved noise reduction is needed.
LOG_HTTP_REQUESTS=true
EXTERNAL_API_RATE_LIMIT_PER_MINUTE=120
OTEL_EXPORTER_OTLP_ENDPOINT=
